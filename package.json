{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "build:ssr": "vite build && vite build --ssr",
    "format": "prettier --write resources/",
    "format:check": "prettier --check resources/",
    "lint": "eslint . --fix",
    "types": "tsc --noEmit -p tsconfig.dev.json",
    "test:e2e": "playwright test",
    "lib:local": "node scripts/set-ui-dep.mjs local && pnpm install",
    "lib:prod": "node scripts/set-ui-dep.mjs prod && pnpm install"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "laravel-vite-plugin": "^3.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@axolotesource/ui": "github:AxoloteSource/ui#main",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.105.0",
    "apexcharts": "^4.7.0",
    "axios": "^1.21.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "formik": "^2.4.9",
    "i18next": "^25.10.10",
    "lucide-react": "^1.64.0",
    "mantine-datatable": "^8.3.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^16.6.6",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "react-select": "^5.10.2",
    "sileo": "^0.1.6",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.7.0",
    "yup": "^1.7.1",
    "yup-locales": "^1.2.28"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5",
    "@rollup/rollup-win32-x64-msvc": "4.9.5",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
