{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "build:ssr": "vite build && vite build --ssr",
    "format": "prettier --write resources/",
    "format:check": "prettier --check resources/",
    "lint": "eslint . --fix",
        "types": "tsc --noEmit -p tsconfig.dev.json",
        "test:e2e": "playwright test",
        "lib:local": "node scripts/set-ui-dep.mjs local && pnpm install",
    "lib:prod": "node scripts/set-ui-dep.mjs prod && pnpm install"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^15.14.0",
    "laravel-vite-plugin": "^3.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.23.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@axolotesource/ui": "github:AxoloteSource/ui#main",
    "@mantine/core": "^8.3.13",
    "@mantine/hooks": "^8.3.7",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-query": "^5.90.20",
    "apexcharts": "^4.5.0",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "formik": "^2.4.9",
    "i18next": "^25.8.0",
    "lucide-react": "^1.3.0",
    "mantine-datatable": "^8.3.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.0",
    "react-i18next": "^16.5.4",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.0",
    "react-select": "^5.10.1",
    "sileo": "^0.1.5",
    "sweetalert2": "^11.26.17",
    "tailwind-merge": "^3.0.1",
    "yup": "^1.7.1",
    "yup-locales": "^1.2.28"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5",
    "@rollup/rollup-win32-x64-msvc": "4.9.5",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
    "lightningcss-linux-x64-gnu": "^1.29.1",
    "lightningcss-win32-x64-msvc": "^1.29.1"
  }
}
